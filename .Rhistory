guides(col = "none", fill = "none") +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
scale_size_continuous(range = c(5,15))
ggsave("images/archdistances_k_means.png", width = 7, height = 5, dpi = 600)
